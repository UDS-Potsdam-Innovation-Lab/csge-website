---
import Logo from './Logo.astro';
import { ui, type Lang } from '../i18n';

interface Item {
  href: string;
  label: string;
}

interface Props {
  lang?: Lang;
  homeHref: string;
  nav: Item[];
  menu?: Item[];
  cta: Item;
  sticky?: boolean;
}

const { lang = 'en', homeHref, nav, menu = nav, cta, sticky = false } = Astro.props;
const t = ui[lang];
---

<header class:list={['header', { 'header--sticky': sticky }]} data-header>
  <div class="container header__inner">
    <a href={homeHref} class="brand">
      <Logo width={42} height={36} />
      <span class="brand__text">
        <span class="brand__name">CSGE</span>
        <span class="brand__sub">{t.brandSub}</span>
      </span>
      <span class="sr-only">{t.homeAria}</span>
    </a>

    {
      nav.length > 0 && (
        <nav aria-label={t.navAria} class="header__nav" data-spy>
          {nav.map((item) => (
            <a href={item.href} class="nav-link">
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="header__actions">
      <a href={cta.href} class="btn btn--primary header__cta" data-magnetic>{cta.label}</a>
      {
        menu.length > 0 && (
          <button
            type="button"
            class="header__toggle"
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label={t.openMenu}
            data-open-label={t.openMenu}
            data-close-label={t.closeMenu}
            data-menu-toggle
          >
            <span class="header__bars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
        )
      }
    </div>
  </div>

  {
    menu.length > 0 && (
      <div id="site-menu" class="menu" data-menu hidden>
        <nav aria-label={t.siteAria} class="container menu__inner" data-spy>
          {menu.map((item) => (
            <a href={item.href} class="menu__link">
              {item.label}
            </a>
          ))}
          <a href={cta.href} class="btn btn--lg btn--primary menu__cta">
            {cta.label}
          </a>
        </nav>
      </div>
    )
  }
</header>

<style>
  .header {
    position: relative;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--line-soft);
    transition: box-shadow 0.3s var(--ease-out);
  }
  .header--sticky {
    position: sticky;
    top: 0;
  }
  .header--sticky.is-scrolled {
    box-shadow: 0 12px 32px -20px rgba(46, 29, 87, 0.28);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    gap: 28px;
  }

  .brand {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    color: var(--violet);
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.05;
  }
  .brand__name {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.4px;
  }
  .brand__sub {
    font-size: 10px;
    font-weight: 500;
    color: var(--grey-2);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .header__nav {
    flex: 1 1 auto;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 2px;
    min-width: 0;
  }
  .nav-link {
    position: relative;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--grey);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 5px;
    height: 2px;
    border-radius: 2px;
    background: var(--violet);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out);
  }
  .nav-link:hover {
    color: var(--violet);
    background: var(--mist-2);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .nav-link.is-active {
    color: var(--violet);
    font-weight: 600;
    background: var(--mist-2);
  }

  .header__actions {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .header__cta {
    padding: 9px 18px;
    font-size: 14px;
  }

  .header__toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    place-items: center;
  }
  .header__toggle:hover {
    border-color: var(--violet);
    background: var(--mist-2);
  }
  .header__bars {
    position: relative;
    display: block;
    width: 16px;
    height: 12px;
  }
  .header__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.25s var(--ease-out),
      opacity 0.2s,
      top 0.25s var(--ease-out);
  }
  .header__bars span:nth-child(1) {
    top: 0;
  }
  .header__bars span:nth-child(2) {
    top: 5px;
  }
  .header__bars span:nth-child(3) {
    top: 10px;
  }
  .header__toggle[aria-expanded='true'] .header__bars span:nth-child(1) {
    top: 5px;
    transform: rotate(45deg);
  }
  .header__toggle[aria-expanded='true'] .header__bars span:nth-child(2) {
    opacity: 0;
  }
  .header__toggle[aria-expanded='true'] .header__bars span:nth-child(3) {
    top: 5px;
    transform: rotate(-45deg);
  }

  .menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border-bottom: 1px solid var(--line-soft);
    box-shadow: 0 24px 40px -24px rgba(46, 29, 87, 0.3);
    max-height: calc(100dvh - var(--header-h) - 40px);
    overflow-y: auto;
  }
  .menu__inner {
    display: flex;
    flex-direction: column;
    padding-block: 12px 28px;
  }
  .menu__link {
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .menu__link:hover,
  .menu__link.is-active {
    color: var(--violet);
  }
  .menu__cta {
    margin-top: 20px;
  }

  @media (max-width: 1280px) {
    .brand__sub {
      display: none;
    }
  }
  @media (max-width: 1120px) {
    .header__nav {
      display: none;
    }
    .header__toggle {
      display: grid;
    }
    .header__inner {
      gap: 16px;
    }
  }
  @media (max-width: 420px) {
    .header__cta {
      padding: 8px 14px;
    }
  }
</style>
