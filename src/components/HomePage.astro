  }
  .apply__alt:hover {
    color: var(--amber);
  }
  .apply__note {
    font-size: 14px;
    color: #cfc3ea;
  }

  .faq {
    background: var(--mist-2);
    border: 1px solid transparent;
    border-radius: var(--r-card);
