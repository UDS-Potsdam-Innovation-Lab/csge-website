  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .step {
    background: #fff;
    color: var(--ink);
    border-radius: var(--r-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: visible;
  }
  .step__num {
    width: 44px;
    height: 44px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
  .step--last {
    background: var(--amber);
