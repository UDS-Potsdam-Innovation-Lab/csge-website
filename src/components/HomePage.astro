    font-family: var(--font-head);
    color: var(--ink);
  }
  .about__role img {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    object-fit: contain;
    border-radius: 8px;
  }

  .experience__media {
    border-radius: 16px;
