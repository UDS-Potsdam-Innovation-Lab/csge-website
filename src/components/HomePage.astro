  .about__points li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .about__points strong {
    display: block;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    color: var(--ink);
  }
  .about__points li span span {
    display: block;
    font-size: 17px;
    color: var(--grey);
  }
  .about__check {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    border-radius: 50%;
