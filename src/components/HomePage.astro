    transform: scaleX(1);
  }
  .feature__title {
    font-size: 24px;
  }

  .program-title {
    font-weight: 800;
    font-size: clamp(24px, 3.4vw, 30px);
    line-height: 1.2;
    color: var(--violet);
  }
  .program-title--xl {
    font-size: clamp(28px, 4vw, 34px);
  }
  .finder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    padding: 16px 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }
  .finder__label {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
  }
  .finder__options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .finder__option {
    border: 1.5px solid var(--line);
    background: var(--mist-2);
    color: var(--ink);
    border-radius: var(--r-pill);
    padding: 7px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.25s var(--ease-out),
      box-shadow 0.25s;
  }
  .finder__option:hover {
    border-color: var(--violet);
    transform: translateY(-1px);
  }
  .finder__option[aria-pressed='true'] {
    background: var(--violet);
    border-color: var(--violet);
    color: #fff;
    transform: none;
    box-shadow: 0 8px 16px -10px rgba(46, 29, 87, 0.55);
