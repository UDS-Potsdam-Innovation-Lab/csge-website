---
import Base from '../layouts/Base.astro';
import TopBar from './TopBar.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CornerFrame from './CornerFrame.astro';
import HeroPass from './HeroPass.astro';
import SectionHead from './SectionHead.astro';
import { href, links } from '../config';
import { home, pages, ui, withLang, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const lang: Lang = Astro.props.lang ?? 'en';
const t = home[lang];
const u = ui[lang];
const loc = pages[lang];
const path = (to: string) => withLang(lang, to);

const footerLinks = [
  ...t.footer,
  { href: path('/imprint/'), label: u.imprint },
  { href: path('/privacy/'), label: u.privacy },
];
---

<Base
  lang={lang}
  title={loc.home.title}
  description={loc.home.description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
    mainEntity: t.faq.items
      .filter((item) => !item.a.startsWith('['))
      .map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
  }}
>
  <TopBar lang={lang} action={{ href: path('/consultation/'), label: u.bookConsultation }} />
  <Header
    lang={lang}
    homeHref="#top"
    nav={t.nav}
    menu={t.menu}
    cta={{ href: '#apply', label: u.apply }}
    sticky
  />

  <main>
    <section id="top" class="bg-violet-dots hero-stage">
      <div class="container hero split">
        <div class="hero__par" data-parallax="0.05" style="--basis:480px">
          <div class="stack hero__copy intro" style="--gap:24px">
            <div class="eyebrow eyebrow--amber hero__eyebrow">{t.hero.eyebrow}</div>
            <h1 class="h1">
              {t.hero.title}<br /><span class="hero__accent">{t.hero.titleAccent}</span>
            </h1>
            <p class="hero__lead">
              <b>{t.hero.goal}</b> <span class="hero__accent">{t.hero.pathway}</span>
            </p>
            <div class="hero__actions">
              <a href="#apply" class="btn btn--lg btn--amber" data-magnetic>{t.hero.apply}</a>
              <a href="#programs" class="btn btn--lg btn--ghost-light" data-magnetic>{t.hero.explore}</a>
            </div>
          </div>
        </div>

        <div class="hero__par hero__par--visual" data-parallax="0.08">
          <CornerFrame size={84} thickness={10} padding={28} color="var(--amber)" radius={6} class="hero__visual intro">
            <HeroPass lang={lang} />
          </CornerFrame>
        </div>
      </div>
    </section>

    <section id="how" aria-labelledby="how-h">
      <div class="container section stack" style="--gap:40px">
        <SectionHead eyebrow={t.how.eyebrow} id="how-h" width={760} lead={t.how.lead}>{t.how.title}</SectionHead>
        <div class="grid how" style="--min:240px;--gap:24px" data-reveal-stagger="70">
          {
            t.how.steps.map((step, i) => (
              <a
                class="how__card"
                href={step.href}
                target={'external' in step && step.external ? '_blank' : undefined}
                rel={'external' in step && step.external ? 'noopener' : undefined}
              >
                <img src={step.image} alt={step.alt} width="800" height="520" loading="lazy" decoding="async" />
                <h3 class="how__title">
                  <span class:list={['how__num', { 'how__num--amber': 'amber' in step && step.amber }]} aria-hidden="true">{i + 1}</span>
                  {step.title}
                </h3>
                <span class="how__cta">{step.cta} <span aria-hidden="true">→</span></span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id="about" aria-labelledby="about-h" class="bg-mist-2">
      <div class="container section split">
        <div class="about__visual" data-reveal>
          <CornerFrame>
            <div class="about__media">
              <video
                src={t.about.video}
                poster={t.about.poster}
                controls
                playsinline
                preload="metadata"
                aria-label={t.about.videoLabel}
              ></video>
              <p class="about__caption">{t.about.caption}</p>
            </div>
          </CornerFrame>
        </div>
        <div class="stack about__copy" style="--gap:18px;--basis:480px">
          <SectionHead eyebrow={t.about.eyebrow} id="about-h">{t.about.title}</SectionHead>
          <ul class="about__points">
            {
              t.about.points.map((point) => (
                <li>
                  <span class="about__check" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24">
                      <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span>
                    <strong>{point.title}</strong>
                    <span>{point.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="about__roles">
            <div class="about__role">
              <img src="/images/logo-uds.png" alt="" width="30" height="30" />
              <span><b>{t.about.udsName}</b> {t.about.uds}</span>
            </div>
            <div class="about__role">
              <img src="/images/logo-csge.png" alt="" width="40" height="40" />
              <span><b>{t.about.csgeName}</b> {t.about.csge}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="potsdam" aria-labelledby="potsdam-h">
      <div class="container section stack" style="--gap:56px">
        <SectionHead eyebrow={t.potsdam.eyebrow} id="potsdam-h">{t.potsdam.title}</SectionHead>
        <div class="grid" style="--min:300px;--gap:24px" data-reveal-stagger="100">
          {
            t.potsdam.items.map((item) => (
              <div class="stack experience" style="--gap:14px">
                <div class="experience__media">
                  {'video' in item && item.video ? (
                    <video src={item.video} poster={item.poster} controls playsinline preload="metadata" aria-label={item.alt}></video>
                  ) : (
                    <img
                      src={item.image}
                      alt={item.alt}
                      style={'position' in item && item.position ? `object-position:${item.position}` : undefined}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <h3 class="card-title">{item.title}</h3>
                <p class="text">{item.text}</p>
              </div>
            ))
          }
        </div>
        <div class="event" data-reveal>
          <div class="stack" style="--gap:6px">
            <div class="kicker"><span class="live-dot" aria-hidden="true"></span>{t.potsdam.nextEvent}</div>
            <div class="event__name">{t.potsdam.eventName}</div>
          </div>
          <a href="#contact" class="btn btn--lg btn--primary" data-magnetic>{t.potsdam.register}</a>
        </div>
      </div>
    </section>

    <section id="future" aria-labelledby="future-h" class="bg-mist-dots">
      <div class="container section stack" style="--gap:56px">
        <SectionHead eyebrow={t.future.eyebrow} id="future-h" width={900} lead={t.future.lead}>
          {t.future.titleBefore}<br /><span style="color:var(--violet)">{t.future.titleAccent}</span>
        </SectionHead>
        <div class="future-photo" data-reveal>
          <CornerFrame color="var(--amber)" padding={14} size={64} thickness={8}>
            <div class="future-photo__frame">
              <img src={t.future.photo} alt={t.future.photoAlt} width="2000" height="1330" loading="lazy" decoding="async" />
              <span class="media-tag"><span class="media-tag__mark" aria-hidden="true"></span>{t.future.photoCaption}</span>
            </div>
          </CornerFrame>
        </div>
        <div class="values" data-reveal-stagger="100">
          {
            t.future.values.map((v) => (
              <div class="values__item">
                <div class="values__title">{v.title}</div>
                <p class="text" style="font-size:16px">{v.text}</p>
              </div>
            ))
          }
        </div>
        <div class="grid" style="--min:300px" data-reveal-stagger="100">
          <div class="feature" data-tilt>
            <div class="feature__bar" style="background:var(--teal)" aria-hidden="true"></div>
            <h3 class="feature__title">{t.future.aiTitle}</h3>
            <p class="text" style="font-size:16px">{t.future.aiLead}</p>
            <ul class="list">
              {t.future.aiItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="feature" data-tilt>
            <div class="feature__bar" style="background:var(--violet)" aria-hidden="true"></div>
            <h3 class="feature__title">{t.future.personalTitle}</h3>
            <p class="text" style="font-size:16px">{t.future.personalLead}</p>
            <ul class="list">
              {t.future.personalItems.map((item) => <li>{item}</li>)}
              <li>
                {t.future.weeklySupport} <a href="#support" style="font-weight:700">{t.future.meetTeam}</a>
              </li>
            </ul>
          </div>
          <div class="feature feature--violet" data-tilt>
            <div class="feature__bar" style="background:var(--amber)" aria-hidden="true"></div>
            <h3 class="feature__title">{t.future.europeTitle}</h3>
            <p class="text" style="font-size:16px;color:var(--on-violet-2)">{t.future.europeLead}</p>
            <ul class="list" style="color:#fff">
              {t.future.europeItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="programs" aria-labelledby="programs-h" class="bg-paper">
      <div class="container section stack" style="--gap:56px">
        <SectionHead eyebrow={t.programs.eyebrow} id="programs-h" width={640}>
          {t.programs.title}
          <Fragment slot="aside">{t.programs.aside}</Fragment>
        </SectionHead>

        <div class="stack" style="--gap:32px">
          <div class="panel" data-reveal>
            <div class="ed4">
              <div class="stack ed4__copy" style="--gap:12px">
                <div class="kicker">{t.programs.microKicker}</div>
                <h3 class="program-title program-title--xl">Ed4Change</h3>
                <p class="text" style="font-size:16px">{t.programs.ed4changeLead}</p>
                <p class="ed4__online">{t.programs.online}</p>
                <a href="#apply" class="btn btn--primary" data-magnetic>{t.programs.applyEd4}</a>
              </div>
              <figure class="ed4__media">
                <img src={t.programs.platformImage} alt={t.programs.platformAlt} width="1600" height="1067" loading="lazy" decoding="async" />
                <span class="media-tag"><span class="media-tag__mark" aria-hidden="true"></span>{t.programs.platformCaption}</span>
              </figure>
            </div>

            <div class="grid tracks" style="--min:230px;--gap:16px">
              {
                t.programs.ed4change.map((track) =>
                  'soon' in track && track.soon ? (
                    <div class="card track track--soon" data-tilt data-track-card={track.name}>
                      <div class="track__head">
                        <div class="track__name">{track.name}</div>
                        <span class="badge-soon">{t.programs.comingSoon}</span>
                      </div>
                      <div class="kicker track__audience">{track.audience}</div>
                      <p class="text">{track.text}</p>
                      <a href={path('/consultation/')} class="track__foot track__link">
                        {t.programs.registerInterest} <span class="arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  ) : (
                    <div class="card track" data-tilt data-track-card={track.name}>
                      <div class="track__name">{track.name}</div>
                      <div class="kicker track__audience">{track.audience}</div>
                      <p class="text">{track.text}</p>
                      <div class="track__foot">
                        <span class="track__price">{track.price}</span>
                        {'priceNote' in track && track.priceNote && <span class="track__note">{track.priceNote}</span>}
                      </div>
                    </div>
                  ),
                )
              }
            </div>
          </div>

          <div class="grid" style="--min:340px;--gap:32px" data-reveal-stagger="100">
            <div class="panel degree" data-tilt>
              <div class="kicker">{t.programs.mscKicker}</div>
              <div class="stack" style="--gap:6px">
                <h3 class="program-title">Young M.Sc.</h3>
                <div class="degree__price">€<span data-count="7500">7,500</span> <span class="degree__per">{t.programs.mscPricePer}</span></div>
              </div>
              <p class="text" style="font-size:16px">{t.programs.mscLead}</p>
              <ul class="degree__list">
                {t.programs.mscItems.map((item) => <li>{item}</li>)}
              </ul>
              <a href="#apply" class="btn btn--primary degree__cta" data-magnetic>{t.programs.applyMsc}</a>
            </div>
            <div class="panel degree" data-tilt>
              <div class="kicker">{t.programs.mbaKicker}</div>
              <div class="stack" style="--gap:6px">
                <h3 class="program-title">Builder MBA</h3>
                <div class="degree__price">{t.programs.comingSoon}</div>
              </div>
              <p class="text" style="font-size:16px">{t.programs.mbaLead}</p>
              <ul class="degree__list">
                {t.programs.mbaItems.map((item) => <li>{item}</li>)}
              </ul>
              <a href={path('/consultation/')} class="btn btn--ghost degree__cta" data-magnetic>{t.programs.registerInterest}</a>
            </div>
          </div>

          <div class="panel visa" data-reveal>
            <div class="stack" style="--gap:10px;max-width:760px">
              <div class="kicker">{t.programs.visaKicker}</div>
              <h3 class="program-title">{t.programs.visaTitle}</h3>
            </div>
            <div class="grid" style="--min:300px">
              <div class="visa__card" data-tilt>
                <div class="kicker">{t.programs.during}</div>
                <h4 class="visa__title">{t.programs.shortVisa}</h4>
                <p class="text">{t.programs.shortVisaText}</p>
              </div>
              <div class="visa__card" data-tilt>
                <div class="kicker">{t.programs.after}</div>
                <h4 class="visa__title">{t.programs.longVisa}</h4>
                <p class="text">{t.programs.longVisaText}</p>
              </div>
            </div>
            <p class="fine-print">{t.programs.visaFine}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="board" aria-labelledby="board-h" class="bg-mist">
      <div class="container section stack" style="--gap:56px">
        <SectionHead eyebrow={t.board.eyebrow} id="board-h" lead={t.board.lead}>
          {t.board.title}
        </SectionHead>

        <div class="chair" data-reveal>
          <div class="chair__portrait">
            <CornerFrame size={44} thickness={6} padding={12}>
              <img src="/images/meinel.jpg" alt={t.board.chairAlt} width="196" height="196" loading="lazy" decoding="async" />
            </CornerFrame>
            <div class="kicker" style="font-size:14px">{t.board.chair}</div>
          </div>
          <div class="stack chair__body" style="--gap:24px">
            <div class="stack" style="--gap:6px">
              <div class="kicker" style="font-size:15px">{t.board.prof}</div>
              <h3 class="chair__name">Christoph Meinel</h3>
              <div class="chair__role">{t.board.chairRole}</div>
            </div>
            <p class="text" style="font-size:16px;line-height:1.7;max-width:720px">{t.board.chairBio}</p>
            <dl class="stats">
              {
                t.board.stats.map((s) => (
                  <div class="stat">
                    <dt class="stat__label">{s.label}</dt>
                    <dd class="stat__num"><span data-count={s.count}>{s.count}</span>{s.suffix}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="grid" style="--min:200px;--gap:24px">
              {
                t.board.merits.map((m, i) => (
                  <div class="merit" style={`--merit:${['var(--violet)', 'var(--teal)', 'var(--amber)'][i]}`}>
                    <h4>{m.title}</h4>
                    <ul>
                      {m.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="grid" style="--min:220px;--gap:48px 24px;align-items:start" data-reveal-stagger="90">
          {
            t.board.members.map((person) => (
              <div class="member">
                <div class="member__photo">
                  <img src={person.image} alt={t.board.portraitOf(person.name)} width="160" height="160" loading="lazy" decoding="async" />
                </div>
                <div class="kicker member__title">{t.board.prof}</div>
                <h3 class="member__name">{person.name}</h3>
                <div class="member__role">{person.role}</div>
                <div class="member__rule" aria-hidden="true"></div>
                <p class="member__bio">
                  {person.bio[0]}
                  <br />
                  {person.bio[1]}
                </p>
              </div>
            ))
          }
        </div>

        <div id="support" class="support" data-reveal>
          <div class="stack" style="--gap:8px;max-width:640px">
            <div class="kicker">{t.board.supportKicker}</div>
            <h3 class="support__title">{t.board.supportTitle}</h3>
          </div>
          <div class="grid" style="--min:240px;--gap:16px">
            {
              t.board.learningSupport.map((s) => (
                <div class="card" data-tilt>
                  <div class="support__logo">
                    <img src={s.logo} alt={s.logoAlt} width="40" height="40" />
                  </div>
                  <div class="kicker" style="font-size:12px">{t.board.supportLabel}</div>
                  <div class="support__name">{s.name}</div>
                  <p class="text" style="font-size:14px">{s.text}</p>
                </div>
              ))
            }
          </div>
          <div class="stack" style="--gap:16px">
            <h4 class="support__sub">{t.board.advisorsTitle}</h4>
            <div class="grid" style="--min:260px;--gap:16px">
              {
                t.board.advisors.map((a) => (
                  <div class="card advisor" data-tilt>
                    <div class="advisor__photo">{t.board.photo}</div>
                    <div class="stack" style="--gap:4px;min-width:0">
                      <div class="advisor__name">{a.name}</div>
                      <div class="advisor__role">{a.role}</div>
                      <div class="advisor__focus">{a.focus}</div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="partners" aria-labelledby="partners-h" class="bg-sand">
      <div class="container section stack" style="--gap:48px">
        <SectionHead eyebrow={t.partners.eyebrow} id="partners-h">{t.partners.title}</SectionHead>
        <div class="grid" style="--min:220px;--gap:16px" data-reveal-stagger="80">
          {t.partners.items.map((item) => <div class="partner" data-tilt>{item}</div>)}
        </div>
        <div class="partners__cta" data-reveal>
          <p class="text-lg">{t.partners.cta}</p>
          <a href="#contact" class="btn btn--ghost" data-magnetic>{t.partners.become}</a>
        </div>
      </div>
    </section>

    <section id="apply" aria-labelledby="apply-h" class="bg-violet-dots">
      <div class="container section stack" style="--gap:56px">
        <SectionHead eyebrow={t.apply.eyebrow} id="apply-h" dark width={680}>
          {t.apply.title}
          <Fragment slot="aside">{t.apply.aside}</Fragment>
        </SectionHead>
        <ol class="grid steps" style="--min:230px;--gap:20px" data-reveal-stagger="100">
          {
            t.apply.steps.map((s, i) => (
              <li class:list={['step', { 'step--last': i === t.apply.steps.length - 1 }]} data-tilt>
                <div class="step__num" aria-hidden="true">{i + 1}</div>
                <h3 class="card-title">{s.title}</h3>
                <p class="text">{s.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="apply__cta" data-reveal>
          <a href={href(links.apply)} class="apply__btn" data-magnetic>{t.hero.apply}</a>
          <a href={path('/consultation/')} class="apply__alt">
            {t.apply.unsure} <span class="arrow" aria-hidden="true">→</span>
          </a>
          <p class="apply__note">{t.apply.note}</p>
        </div>
      </div>
    </section>

    <section id="faq" aria-labelledby="faq-h" class="bg-warm">
      <div class="container section stack" style="--gap:48px;max-width:900px">
        <SectionHead eyebrow={t.faq.eyebrow} id="faq-h">{t.faq.title}</SectionHead>
        <div class="stack" style="--gap:12px" data-reveal-stagger="50">
          {
            t.faq.items.map((f) => (
              <details class="faq" data-accordion>
                <summary>
                  {f.q}
                  <span class="faq__plus" aria-hidden="true" />
                </summary>
                <div class="faq__body" data-accordion-body>
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-h" class="bg-deep">
      <div class="container section contact">
        <div class="stack contact__main" style="--gap:32px">
          <SectionHead eyebrow={t.contact.eyebrow} id="contact-h" dark>{t.contact.title}</SectionHead>
          <address class="contact__details" data-reveal>
            <div><span>{t.contact.address}</span>{t.contact.addressValue}</div>
            <div><span>{t.contact.email}</span>[info@your-domain]</div>
            <div><span>{t.contact.phone}</span>[+49 …]</div>
            <div><span>{t.contact.wechat}</span>{t.contact.wechatId}</div>
          </address>
        </div>
        <div class="contact__aside" data-reveal>
          <div class="contact__wechat">
            <div class="contact__qr">{t.contact.qr}</div>
            <p>{t.contact.scan}</p>
          </div>
          <a href={path('/consultation/')} class="btn btn--lg btn--amber" data-magnetic>{t.contact.book}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} links={footerLinks} />
</Base>

<style>
  .hero-stage {
    position: relative;
    overflow: hidden;
  }
  #apply {
    position: relative;
  }
  .hero {
    position: relative;
    z-index: 1;
    padding-block: clamp(72px, 8vw, 104px);
  }
  .hero.split {
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
  }
  .hero__eyebrow {
    font-size: 18px;
  }
  .hero .h1 {
    line-height: 1.05;
  }
  .hero__accent {
    color: var(--amber);
  }
  .hero__lead {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.25;
    max-width: 640px;
    color: #fff;
  }
  .hero__lead b {
    font-weight: 700;
    color: #fff;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  .hero__par--visual {
    --basis: 540px;
