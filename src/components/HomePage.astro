    padding-left: 0;
  }
  @media (max-width: 760px) {
    .values__item {
      padding-inline: 0;
    }
    .values__item + .values__item {
      border-left: 0;
      border-top: 1px solid var(--lilac);
    }
  }
  .values__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 24px;
    color: var(--violet);
  }
  .feature {
    background: #fff;
    border: 1px solid var(--line);
